<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pinball-workshop.dev</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>export PATH="/opt/homebrew/opt/node@22/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"; exec pnpm dev</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/Sites/pinball-workshop</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/pinball-workshop-dev.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pinball-workshop-dev.log</string>
</dict>
</plist>
